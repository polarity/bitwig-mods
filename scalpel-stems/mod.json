{
  "manifest_version": 2,
  "mod": {
    "id": "scalpel-stems",
    "name": "Audio Clip: Scalpel Stem Separation",
    "version": "0.1.0-dev.6",
    "author": "Polarity",
    "description": "Separate songs into stems and split drums into kick, snare, hi-hat, toms, ride, crash and remainder.",
    "area": "Audio Clip",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "targets": {},
  "hooks": [],
  "requires": [
    {
      "id": "audio-analysis-runtime",
      "min_version": "0.1.0-dev.4"
    },
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    },
    "engine": {
      "kind": "directory",
      "path": "engine"
    },
    "cuda-dialog": {
      "kind": "file",
      "path": "helper.jar",
      "media_type": "application/java-archive"
    },
    "runtime": {
      "kind": "directory",
      "path": "runtime",
      "persistence": "preserve"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
