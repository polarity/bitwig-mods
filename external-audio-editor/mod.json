{
  "manifest_version": 2,
  "mod": {
    "id": "external-audio-editor",
    "name": "Inspector: External Audio Editor",
    "area": "Inspector",
    "version": "0.1.0-dev.2",
    "author": "Polarity",
    "description": "Open the selected audio clip or event's original sample file in a configurable external editor.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "inspector-composition-framework", "min_version": "0.3.0-dev.2" },
    { "id": "preferences-composition-framework", "min_version": "1.0.0" },
    { "id": "notifications-framework", "min_version": "0.3.0-dev.1" }
  ],
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" },
    "editor-dialog": { "kind": "file", "path": "helper.jar", "media_type": "application/java-archive" }
  },
  "registrations": [
    {
      "id": "inspector",
      "consumer": "inspector-composition-framework",
      "descriptor": "inspector-blocks.properties",
      "jar": "helper.jar"
    },
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ]
}
