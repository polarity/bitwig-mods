{
  "manifest_version": 2,
  "mod": {
    "id": "popup-live-preview",
    "name": "Browser: Remember Live Preview",
    "area": "Browser",
    "version": "0.1.0-dev.1",
    "author": "Polarity",
    "description": "Remember the Pop-up Browser's Live Preview checkbox or choose a fixed starting state.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" }
  ],
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ]
}
